{
  "info": {
    "name": "student-portal",
    "description": "Student Management API - students, courses and enrollments. Backend must be running on localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Students",
      "item": [
        {
          "name": "Get all students",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/students"
          }
        },
        {
          "name": "Search students",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/students?search=john",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"],
              "query": [
                {
                  "key": "search",
                  "value": "john"
                }
              ]
            }
          }
        },
        {
          "name": "Get student by id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/students/1"
          }
        },
        {
          "name": "Create student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Sara\",\n  \"lastName\": \"Kim\",\n  \"email\": \"sara.kim@gmail.com\",\n  \"dateOfBirth\": \"2003-05-15\"\n}"
            },
            "url": "{{baseUrl}}/api/students"
          }
        },
        {
          "name": "Create student - validation error",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"\",\n  \"lastName\": \"Kim\",\n  \"email\": \"not-an-email\",\n  \"dateOfBirth\": \"2030-01-01\"\n}"
            },
            "url": "{{baseUrl}}/api/students"
          }
        },
        {
          "name": "Update student",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Smith\",\n  \"email\": \"john.smith@yahoo.com\",\n  \"dateOfBirth\": \"2001-04-12\"\n}"
            },
            "url": "{{baseUrl}}/api/students/1"
          }
        },
        {
          "name": "Delete student",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/students/1"
          }
        }
      ]
    },
    {
      "name": "Enrollment",
      "item": [
        {
          "name": "Enroll student in course",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/students/1/courses/3"
          }
        },
        {
          "name": "Remove course from student",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/students/1/courses/3"
          }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "Get all courses",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/courses"
          }
        },
        {
          "name": "Search courses",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/courses?search=math",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courses"],
              "query": [
                {
                  "key": "search",
                  "value": "math"
                }
              ]
            }
          }
        },
        {
          "name": "Get course by id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/courses/1"
          }
        },
        {
          "name": "Create course",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseCode\": \"HIST110\",\n  \"courseName\": \"World History\",\n  \"description\": \"From ancient to modern\"\n}"
            },
            "url": "{{baseUrl}}/api/courses"
          }
        },
        {
          "name": "Create course - duplicate code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseCode\": \"CS101\",\n  \"courseName\": \"Another Java Course\",\n  \"description\": \"should conflict\"\n}"
            },
            "url": "{{baseUrl}}/api/courses"
          }
        },
        {
          "name": "Update course",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseCode\": \"ENG105\",\n  \"courseName\": \"Academic Writing II\",\n  \"description\": \"Advanced writing\"\n}"
            },
            "url": "{{baseUrl}}/api/courses/3"
          }
        },
        {
          "name": "Delete course",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/courses/3"
          }
        },
        {
          "name": "Delete course with students - blocked",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/courses/1"
          }
        }
      ]
    }
  ]
}
